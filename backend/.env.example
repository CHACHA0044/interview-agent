# ================================================================
# Interview Agent — Root Environment Configuration
# Copy to .env and adjust as needed. NEVER commit real secrets.
#
# Environment Classification Legend:
#   [REQUIRED] Must be defined or defaulted correctly for app function
#   [OPTIONAL] Has sane fallback in code; modify only if customizing
#   [LOCAL]    Used primarily for Docker Compose / local dev setup
#   [RENDER]   Used in single-container Render web service deployment
# ================================================================

# ---- Gateway & Server Binding -----------------------------------
# [RENDER] Render automatically populates PORT for public HTTP binding
PORT=8000
# [LOCAL] Fallback port setting for local development
BACKEND_PORT=8000
# [OPTIONAL / LOCAL] Redis connection string (in-memory store fallback when omitted)
REDIS_URL=redis://redis:6379/0
# [OPTIONAL] Session TTL in seconds
SESSION_TTL_SECONDS=3600
# [REQUIRED / LOCAL] Internal URL for Interview Agent (http://interview-agent:8001 for compose, http://127.0.0.1:8001 for Render)
AGENT_SERVICE_URL=http://127.0.0.1:8001
# [REQUIRED / LOCAL] Internal URL for AI Intelligence (http://ai-intelligence:8002 for compose, http://127.0.0.1:8002 for Render)
AI_SERVICE_URL=http://127.0.0.1:8002
# [OPTIONAL / RENDER] Allowed CORS origins (comma-separated, no trailing slashes)
FRONTEND_ORIGINS=http://localhost:5173
# [OPTIONAL] Shared secret token for internal HTTP endpoints (empty disables check)
INTERNAL_API_TOKEN=

# ---- Gateway Upstream Client Settings ---------------------------
# [OPTIONAL] Connect timeout to internal microservices (seconds)
CONNECT_TIMEOUT_SECONDS=2
# [OPTIONAL] Request timeout to internal microservices (seconds)
REQUEST_TIMEOUT_SECONDS=25
# [OPTIONAL] Internal HTTP request retry attempts
RETRIES=1

# ---- Interview Agent Behavior & Hard Floors --------------------
# [OPTIONAL] Minimum questions floor before finishing interview
MIN_QUESTIONS=8
# [OPTIONAL] Minimum distinct curriculum days floor
MIN_CURRICULUM_DAYS=4
# [OPTIONAL] Total follow-up question budget
FOLLOWUP_BUDGET=4
# [OPTIONAL] Maximum follow-ups allowed per primary question
FOLLOWUP_MAX_PER_QUESTION=2

# ---- AI Intelligence & LLM Provider -----------------------------
# [REQUIRED] LLM provider implementation: 'fake' (zero-key mode) or 'openai'
LLM_PROVIDER=fake
# [OPTIONAL / RENDER] OpenAI / compatible provider API key (required if LLM_PROVIDER=openai)
LLM_API_KEY=
# [OPTIONAL] Primary chat model identifier
LLM_MODEL=gpt-4o-mini
# [OPTIONAL] Custom base URL for OpenAI-compatible endpoint
LLM_BASE_URL=
# [OPTIONAL] Sampling temperature for LLM generation
LLM_TEMPERATURE=0.3
# [OPTIONAL] Embedding model for semantic search
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Vector DB & RAG Retrieval ---------------------------------
# [OPTIONAL / LOCAL] Qdrant instance URL (falls back to in-memory curriculum search when unreachable)
QDRANT_URL=http://qdrant:6333
# [OPTIONAL] Qdrant collection name
QDRANT_COLLECTION=curriculum_days
# [OPTIONAL] Qdrant API key if using authentication
QDRANT_API_KEY=

# ---- Dataset File Paths -----------------------------------------
# [OPTIONAL / RENDER] Path to curriculum JSON file
CURRICULUM_PATH=/app/curriculum.json
# [OPTIONAL / RENDER] Path to candidates JSON file
CANDIDATES_PATH=/app/candidates.json

# ---- Observability ----------------------------------------------
# [OPTIONAL] Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
