# ================================================================
# Interview Agent — root environment configuration
# See backend.md §18 for the full variable reference.
#
# Copy to .env and adjust for local runs. NEVER commit real secrets.
# Safe defaults below let `docker compose up --build` run with no
# real API keys (LLM_PROVIDER=fake).
# ================================================================

# ---- Gateway (services/gateway, backend.md §18.1) --------------
BACKEND_PORT=8000
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600
AGENT_SERVICE_URL=http://interview-agent:8001
AI_SERVICE_URL=http://ai-intelligence:8002
FRONTEND_ORIGINS=http://localhost:5173
INTERNAL_API_TOKEN=
CONNECT_TIMEOUT_SECONDS=2
REQUEST_TIMEOUT_SECONDS=25
RETRIES=1

# ---- Interview Agent (services/interview-agent, §18.2) ----------
# AGENT_PORT=8001
AI_TIMEOUT_SECONDS=30
AI_RETRIES=1

# ---- Hard floors (Gateway + Agent mirror these) -----------------
MIN_QUESTIONS=8
MIN_CURRICULUM_DAYS=4

# ---- Interview Agent behavior (Shezan) ---------------------------
FOLLOWUP_BUDGET=4
FOLLOWUP_MAX_PER_QUESTION=2

# ---- AI Intelligence (services/ai-intelligence, §18.3) -----------
# AI_PORT=8002
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2
EMBEDDINGS_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=3

# ---- Vector DB (Meraj) --------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=curriculum_days
QDRANT_API_KEY=

# ---- Infra (§18.4) ------------------------------------------------
REDIS_PASSWORD=

# ---- Observability ------------------------------------------------
LOG_LEVEL=INFO
