# Interview Agent Gateway — environment configuration (backend.md §18.1)
# Copy to .env and adjust for your local setup.

BACKEND_PORT=8000
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600
AGENT_SERVICE_URL=http://interview-agent:8001
AI_SERVICE_URL=http://ai-intelligence:8002
FRONTEND_ORIGINS=http://localhost:5173

# Hard floors (never below these)
MIN_QUESTIONS=8
MIN_CURRICULUM_DAYS=4

# Internal auth (optional; empty disables)
INTERNAL_API_TOKEN=

# Upstream client behavior
CONNECT_TIMEOUT_SECONDS=2
REQUEST_TIMEOUT_SECONDS=25
RETRIES=1

LOG_LEVEL=INFO
