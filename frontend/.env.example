# Interview Agent — Frontend Environment Configuration
# Copy to `.env` (or `.env.local`, which is gitignored) and adjust as needed.
#
# Base URL of the Interview Agent gateway. The live gateway default is
# https://interview-agent-gateway.onrender.com; the service appends /api/interview.
# Set this to your local gateway (e.g. http://localhost:8000) for local runs.
VITE_API_BASE_URL=https://interview-agent-gateway.onrender.com
